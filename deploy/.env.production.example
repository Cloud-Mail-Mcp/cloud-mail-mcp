# Copy to .env next to deploy/compose.yml (install.sh writes this for you).
MAILMCP_IMAGE=ghcr.io/cloud-mail-mcp/mailmcp
# latest = stable releases, edge = every change on main
MAILMCP_TAG=latest
POSTGRES_PASSWORD=change-me-to-a-long-random-string
AUTO_UPDATE=false

# HTTPS with automatic certificates:
# DOMAIN=mail.example.com
# COMPOSE_PROFILES=https
# MAILMCP_BIND=127.0.0.1:8787
# SECURE_COOKIES=true
# TRUST_PROXY=true

# Plain HTTP (trusted network only):
MAILMCP_BIND=0.0.0.0:8787
SECURE_COOKIES=false
