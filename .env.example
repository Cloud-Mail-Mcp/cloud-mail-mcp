# MailMCP only needs to know how to reach its database.
# Everything else (mail accounts, storage, sync) is configured in the admin panel.
DATABASE_URL=postgres://mailmcp:mailmcp@localhost:5433/mailmcp

# ── Optional ──
# HOST=127.0.0.1
# PORT=8787
# Where the encryption key file and local mail storage live (default: ./data)
# MAILMCP_DATA_DIR=./data
# Supply the encryption key directly instead of data/master.key (base64, 32 bytes).
# Useful with Docker secrets or a key manager.
# MAILMCP_MASTER_KEY=
