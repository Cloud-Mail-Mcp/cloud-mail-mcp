{
  "name": "@mailmcp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p .",
    "seed": "tsx scripts/seed-testmail.ts",
    "sync-once": "tsx --env-file-if-exists=../../.env scripts/sync-once.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@mailmcp/core": "workspace:*",
    "@mailmcp/db": "workspace:*",
    "@mailmcp/module-imap": "workspace:*",
    "@mailmcp/module-sdk": "workspace:*",
    "pg-boss": "^12.38.2"
  },
  "devDependencies": {
    "@mailmcp/search": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "imapflow": "^2.12.1",
    "nodemailer": "^10.6.0"
  }
}
